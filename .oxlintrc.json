{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": ["typescript", "oxc", "import", "unicorn"],
  "env": {
    "bun": true
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "kebabCase": false,
          "camelCase": false,
          "snakeCase": false,
          "pascalCase": true
        }
      }
    ]
  }
}
