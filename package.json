{
  "name": "gfreview",
  "version": "0.1.0",
  "description": "CLI for posting inline diff comments on merge/pull requests",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinffx/gfreview.git"
  },
  "bin": {
    "gfreview": "./index.ts"
  },
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "types": "tsgo --noEmit",
    "lint": "oxlint ./src/",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "build": "bun build index.ts --compile --outfile dist/gfreview"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260314.1",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "oxlint-tsgolint": "^0.16.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
