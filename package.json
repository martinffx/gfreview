{
  "name": "gfreview",
  "version": "0.1.0",
  "description": "CLI for posting inline diff comments on merge/pull requests",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinffx/gfreview.git"
  },
  "bin": {
    "gfreview": "./dist/gfreview.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/gfreview.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "types": "tsgo --noEmit",
    "lint": "oxlint ./src/",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "build": "bun build index.ts --compile --outfile dist/gfreview",
    "build:node": "bun build index.ts --outfile dist/gfreview.js --target=node",
    "build:types": "tsgo --emitDeclarationOnly --declarationDir dist --noEmit false"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "^7.0.0-dev.20260314.1",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "oxlint-tsgolint": "^0.16.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
